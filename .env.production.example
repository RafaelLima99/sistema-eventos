# CONTRATO de variáveis de PRODUÇÃO (lidas por compose.prod.yaml).
# Este arquivo NÃO contém segredos. Valores reais ficam no painel (Coolify etc.)
# e/ou em um .env no servidor (chmod 600) — guarde uma cópia no gerenciador de senhas.

# --- Aplicação ---
APP_NAME="Sistema Eventos"
# Gere com: docker compose -f compose.prod.yaml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://eventos.exemplo.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning

# Rodar migrations automaticamente ao subir o serviço `app` (true/false).
RUN_MIGRATIONS=false

# --- Banco (MySQL) ---
# DB_HOST=db usa o serviço do compose; altere se usar banco externo/gerenciado.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sistema_eventos
DB_USERNAME=sistema
DB_PASSWORD=
# Senha do root do MySQL (usada só pelo serviço db e pelos scripts de backup/restore).
DB_ROOT_PASSWORD=

# --- E-mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sistema Eventos"

# --- Arquivos ---
FILESYSTEM_DISK=local
